# ─────────────────────────────────────────────────
# Life Hub — Environment Variables
# Copy this file to .env.local and fill in values
#   cp .env.local.example .env.local
# ─────────────────────────────────────────────────

# ══════════════════════════════════════════════════
# 1. SUPABASE (Bắt buộc cho Auth + Cloud Sync)
# ══════════════════════════════════════════════════
# Lấy từ: https://supabase.com → Project Settings → API
# Prefix VITE_ = expose cho frontend (chỉ anon key, KHÔNG bao giờ service_role)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ══════════════════════════════════════════════════
# 2. IMGUR (Tùy chọn — Auto-upload ảnh paste/drop)
# ══════════════════════════════════════════════════
# Tạo app tại: https://api.imgur.com/oauth2/addclient
#   - Application name: LifeHub
#   - Authorization type: "Anonymous usage without user authorization"
#   - Authorization callback URL: https://your-domain.vercel.app
# → Lấy Client ID (KHÔNG phải Client Secret)
# ⚠️ KHÔNG có prefix VITE_ — biến này chỉ dùng server-side (Vercel Function)
IMGUR_CLIENT_ID=your-imgur-client-id

# ══════════════════════════════════════════════════
# 3. CLOUDFLARE R2 (Tùy chọn — Upload audio/file)
# ══════════════════════════════════════════════════
# Tạo tại: https://dash.cloudflare.com → R2 → Create Bucket
#   - Bucket name: lifehub-media
#   - Region: Auto
#   - Enable Public Access (Settings → Public access → Allow)
# API Token: R2 → Manage R2 API Tokens → Create API Token
#   - Permission: Object Read & Write
#   - Scope: lifehub-media bucket
# ⚠️ KHÔNG có prefix VITE_ — server-side only
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=lifehub-media
R2_PUBLIC_URL=https://pub-xxx.r2.dev
