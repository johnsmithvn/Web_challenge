# ─────────────────────────────────────────────────
# Life Hub — Environment Variables
# Copy this file to .env.local and fill in values
#   cp .env.local.example .env.local
# ─────────────────────────────────────────────────

# ══════════════════════════════════════════════════
# 1. SUPABASE (Bắt buộc cho Auth + Cloud Sync)
# ══════════════════════════════════════════════════
# Lấy từ: https://supabase.com → Project Settings → API
# Prefix VITE_ = expose cho frontend (chỉ anon key, KHÔNG bao giờ service_role)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ══════════════════════════════════════════════════
# 2. GOOGLE DRIVE SERVICE ACCOUNT (Upload tất cả file)
# ══════════════════════════════════════════════════
# Tạo Service Account tại: https://console.cloud.google.com/iam-admin/serviceaccounts
# Cấp quyền Editor cho thư mục Drive đích. Lấy JSON key.
# Lưu ý: JSON phải được nén thành chuỗi 1 dòng để nhét vào biến môi trường.
# ⚠️ KHÔNG có prefix VITE_ — biến này chỉ dùng server-side (Vercel Function)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
DRIVE_FOLDER_ID=your-google-drive-root-folder-id
